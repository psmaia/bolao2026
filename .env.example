# =====================================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no git
# =====================================================

# Supabase — encontre em: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base da aplicação (sem barra no final)
# Desenvolvimento: http://localhost:3000
# Produção: https://seudominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# hCaptcha — opcional, obtenha em hcaptcha.com (gratuito)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=seu_site_key_aqui

# Google AdSense — opcional, coloque o publisher ID
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
